{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "profiles/*.md",
    "workflows/*.md"
  ],
  "skills": {
    "paths": [
      "./skills",
      "./.opencode/skills"
    ]
  },
  "plugin": [
    "opencode-snip",
    "envsitter-guard",
    "opencode-ignore",
    "ring-a-bell",
    "opencode-notify",
    "tokenscope",
    "opencode-quota",
    "opencode-plugin-openspec",
    "opencode-skills",
    "pocket-universe",
    "opencode-terminal-progress",
    "opencode-model-fallback-chain"
  ],
  "model": "zen/deepseek-v4-flash-free",
  "small_model": "zen/deepseek-v4-flash-free",
  "default_agent": "orchestrator",
  "subagent_depth": 2,
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Proxy (port 8090)",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "sk-local",
        "timeout": 300000
      },
      "models": {
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "google/gemini-2.5-flash-lite": {
          "name": "Gemini 2.5 Flash Lite"
        },
        "google/gemini-3.1-flash-lite-preview": {
          "name": "Gemini 3.1 Flash Lite"
        },
        "google/gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro"
        },
        "moonshotai/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
        "poolside/laguna-s-2.1": {
          "name": "Poolside Laguna S 2.1"
        },
        "mimo/mimo-v2.5-pro": {
          "name": "Mimo V2.5 Pro"
        }
      }
    },
    "zenmux": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ZenMux GLM (Free)",
      "options": {
        "baseURL": "https://zenmux.ai/api/v1",
        "apiKey": "${ZENMUX_API_KEY}",
        "timeout": 300000
      },
      "models": {
        "z-ai/glm-4.7-flash-free": {
          "name": "GLM 4.7 Flash Free",
          "multimodal": false
        },
        "z-ai/glm-4.6v-flash-free": {
          "name": "GLM 4.6v Flash Free",
          "multimodal": false
        }
      }
    },
    "kiro": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kiro Gateway (Claude)",
      "options": {
        "baseURL": "http://127.0.0.1:8333/v1",
        "apiKey": "kiro-gateway-8333",
        "timeout": 300000
      },
      "models": {
        "claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5"
        },
        "claude-sonnet-4": {
          "name": "Claude Sonnet 4"
        },
        "claude-haiku-4.5": {
          "name": "Claude Haiku 4.5"
        },
        "auto-kiro": {
          "name": "Auto (Kiro Select)"
        },
        "deepseek-3.2": {
          "name": "DeepSeek 3.2"
        },
        "qwen3-coder-next": {
          "name": "Qwen3 Coder Next"
        }
      }
    }
  },
  "lsp": true,
  "agent": {
    "orchestrator": {
      "description": "Primary orchestrator for coordinating multi-agent workflows and task decomposition",
      "mode": "primary",
      "permission": { "edit": "allow", "bash": "allow" },
      "model": "zen/mimo-v2.5-free",
      "prompt": "{file:./agents/orchestrator.md}"
    },
    "blueprint": {
      "description": "Strategic planning, brainstorming, architecture design, and research synthesis",
      "mode": "primary",
      "permission": { "edit": "allow", "bash": "allow" },
      "model": "zen/north-mini-code-free",
      "prompt": "{file:./agents/blueprint.md}"
    },
    "explorer": {
      "description": "Codebase search and pattern discovery specialist",
      "mode": "subagent",
      "model": "zen/laguna-s-2.1-free",
      "prompt": "{file:./agents/explorer.md}"
    },
    "librarian": {
      "description": "Documentation and API reference specialist",
      "mode": "subagent",
      "model": "zen/laguna-s-2.1-free",
      "prompt": "{file:./agents/librarian.md}"
    },
    "oracle": {
      "description": "Strategic technical advisor for architecture and complex problems",
      "mode": "subagent",
      "model": "zen/mimo-v2.5-free",
      "prompt": "{file:./agents/oracle.md}"
    },
    "designer": {
      "description": "UI/UX design specialist for polished interfaces",
      "mode": "subagent",
      "model": "zen/laguna-s-2.1-free",
      "prompt": "{file:./agents/designer.md}"
    },
    "fixer": {
      "description": "Code refinement, optimization, refactoring, and cleanup",
      "mode": "subagent",
      "model": "zen/north-mini-code-free",
      "prompt": "{file:./agents/fixer.md}"
    },
    "observer": {
      "description": "Watches and reports on system behavior, logs, and metrics",
      "mode": "subagent",
      "model": "zen/deepseek-v4-flash-free",
      "prompt": "{file:./agents/observer.md}"
    },
    "council": {
      "description": "Multi-perspective deliberation and consensus for complex decisions",
      "mode": "subagent",
      "model": "zen/longcat-2.0-free",
      "prompt": "{file:./agents/council.md}"
    },
    "brainstorming": {
      "description": "Creative ideation and divergent thinking",
      "mode": "subagent",
      "model": "zen/longcat-2.0-free",
      "prompt": "{file:./agents/brainstorming.md}"
    },
    "compaction": {
      "description": "Context compression and session compaction",
      "mode": "subagent",
      "model": "zen/ling-3.0-flash-free",
      "prompt": "{file:./agents/compaction.md}"
    },
    "researcher": {
      "description": "Web research, competitive analysis, and information gathering",
      "mode": "subagent",
      "model": "zen/mimo-v2.5-free",
      "prompt": "{file:./agents/researcher.md}"
    },
    "plan": {
      "description": "Plan grammar enforcement and task breakdown",
      "mode": "subagent",
      "model": "zen/north-mini-code-free",
      "prompt": "{file:./agents/plan.md}"
    },
    "owl-dns": {
      "description": "Web scraping, proxy rotation, DNS tunneling with owl-dns v5.1",
      "mode": "subagent",
      "color": "#6366f1",
      "tools": {
        "bash": true,
        "glob": true,
        "grep": true,
        "read": true,
        "write": true,
        "edit": true,
        "webfetch": false,
        "websearch": false
      },
      "model": "zen/laguna-s-2.1-free",
      "prompt": "{file:./agents/owl-dns.md}"
    },
    "browser-use": {
      "description": "Browser automation for web browsing, UI testing, data scraping",
      "mode": "subagent",
      "tools": {
        "bash": true,
        "glob": true,
        "grep": true,
        "read": true,
        "write": true,
        "edit": true,
        "webfetch": false,
        "websearch": false
      },
      "model": "zen/ling-3.0-flash-free",
      "prompt": "{file:./agents/browser-use.md}"
    },
    "agent-browser": {
      "description": "Structured browser automation via CDP for forms and data extraction",
      "mode": "subagent",
      "tools": {
        "bash": true,
        "glob": true,
        "grep": true,
        "read": true,
        "edit": true,
        "webfetch": false,
        "websearch": false
      },
      "model": "zen/ling-3.0-flash-free",
      "prompt": "{file:./agents/agent-browser.md}"
    },
    "oracle-lite": {
      "description": "Strategic technical advice with lightweight model fallback",
      "mode": "subagent",
      "model": "zen/deepseek-v4-flash-free",
      "prompt": "{file:./agents/oracle-lite.md}"
    },
    "designer-lite": {
      "description": "UI/UX design with lightweight model fallback",
      "mode": "subagent",
      "model": "zen/deepseek-v4-flash-free",
      "prompt": "{file:./agents/designer-lite.md}"
    },
    "observer-lite": {
      "description": "System monitoring with lightweight model fallback",
      "mode": "subagent",
      "model": "zen/deepseek-v4-flash-free",
      "prompt": "{file:./agents/observer-lite.md}"
    },
    "council-lite": {
      "description": "Multi-perspective deliberation with lightweight model fallback",
      "mode": "subagent",
      "model": "zen/deepseek-v4-flash-free",
      "prompt": "{file:./agents/council-lite.md}"
    },
    "owl-agent": {
      "description": "Self-optimising proxy HTTP client with ML quality scoring and 50+ proxy sources",
      "mode": "subagent",
      "color": "#6366f1",
      "tools": {
        "bash": true,
        "glob": true,
        "grep": true,
        "read": true,
        "write": true,
        "edit": true,
        "webfetch": false,
        "websearch": false
      },
      "model": "zen/laguna-s-2.1-free",
      "prompt": "{file:./agents/owl-agent.md}"
    },
  },
  "experimental": {
    "modelFallbackChain": {
      "timeoutMs": 90000,
      "chains": [
        [
          "zen/mimo-v2.5-free",
          "zen/laguna-s-2.1-free",
          "zen/deepseek-v4-flash-free"
        ],
        [
          "zen/laguna-s-2.1-free",
          "zen/mimo-v2.5-free",
          "zen/deepseek-v4-flash-free"
        ],
        [
          "zen/deepseek-v4-flash-free",
          "zen/mimo-v2.5-free",
          "zen/laguna-s-2.1-free"
        ]
      ]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "puppeteer": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      },
      "enabled": false
    },
    "podman": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-server-docker"
      ],
      "env": {
        "DOCKER_HOST": "unix:///run/user/1000/podman/podman.sock"
      },
      "enabled": true
    }
  }
}
